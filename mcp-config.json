{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "{{PROJECT_ROOT}}"]
    },
    "codebase-memory": {
      "command": "codebase-memory-mcp",
      "args": [],
      "env": {
        "CODEBASE_MEMORY_DB": "{{PROJECT_ROOT}}/.aos/memory/{{PROJECT_NAME}}.db"
      }
    }
  },
  "_comment": "Automatically populated by 'aos init'. On Windows, npx will be resolved automatically."
}
