/* DASS-AOS Studio TUI Theme — Obsidian + the four logo bar colors */

/* Brand bars (dark = borders/fills, light = readable text) */
$gold: #b89146;
$gold-l: #d9b15f;
$blue: #537195;
$blue-l: #8aa8cc;
$terra: #844747;
$terra-l: #c46a6a;
$olive: #5b635d;
$olive-l: #9aa59c;
$line: #1f2b3b;

Screen {
    background: #060b11;
    color: #e2e8f0;
}

* {
    scrollbar-size-vertical: 1;
    scrollbar-background: #0b121c;
    scrollbar-color: #2f4058;
    scrollbar-color-hover: $blue;
    scrollbar-color-active: $blue-l;
    scrollbar-corner-color: #0b121c;
}

#top-bar {
    height: 8;
    background: #060b11;
    border: round $line;
    border-title-align: center;
    border-title-color: $gold-l;
    border-title-style: bold;
    padding: 0 2;
    margin: 0 1;
    layout: horizontal;
    align: left middle;
}

#top-project {
    width: 1fr;
    height: 100%;
    padding-right: 2;
    content-align: left middle;
    color: #cbd5e1;
}

#brand-logo {
    width: 57;
    height: 6;
    content-align: right middle;
}

TabbedContent {
    height: 1fr;
    background: #060b11;
}

ContentSwitcher {
    background: #060b11;
    padding: 1 1 0 1;
}

Tabs {
    background: #060b11;
    margin: 0 1;
}

Tabs #tabs-list {
    align: center middle;
}

Tabs .underline--bar {
    color: $gold;
    background: $line;
}

Tab {
    color: #94a3b8;
    padding: 0 2;
}

Tab:hover {
    color: #e2e8f0;
    background: #0f1826;
}

Tab.-active {
    color: $gold-l;
    background: #0f1826;
    text-style: bold;
}

.panel {
    background: #060b11;
    border: round $line;
    border-title-color: $blue-l;
    border-title-style: bold;
    padding: 0 1;
}

.panel:focus-within {
    border: round $gold;
    border-title-color: $gold-l;
}

.kpi-row {
    height: 6;
    layout: horizontal;
    margin-bottom: 1;
}

.kpi-card {
    width: 1fr;
    height: 100%;
    background: #060b11;
    border: round $line;
    border-title-style: bold;
    padding: 0 1;
    margin-right: 1;
    overflow: hidden hidden;
}

/* One logo bar color per KPI card, left to right */
#kpi-plan { border: round $gold; border-title-color: $gold-l; }
#kpi-agents { border: round $blue; border-title-color: $blue-l; }
#kpi-git { border: round $terra; border-title-color: $terra-l; }
#kpi-health { border: round $olive; border-title-color: $olive-l; }
#kpi-tok-in { border: round $gold; border-title-color: $gold-l; }
#kpi-tok-cache { border: round $blue; border-title-color: $blue-l; }
#kpi-tok-out { border: round $terra; border-title-color: $terra-l; }
#kpi-tok-ctx { border: round $olive; border-title-color: $olive-l; }

.kpi-card-last {
    margin-right: 0;
}

/* Dashboard grid: flexible top row, fixed-height bottom row on both columns so edges line up */
.dash-split {
    height: 1fr;
    layout: horizontal;
}

#dash-left {
    width: 3fr;
    height: 100%;
    margin-right: 1;
    layout: vertical;
}

#dash-phases-box, #dash-feed-box {
    height: 1fr;
    margin-bottom: 1;
}

#dash-agents-box, #dash-pulse-box {
    height: 9;
}

#dash-pulse-box {
    overflow: hidden hidden;
    padding-top: 1;
}

#dash-right {
    width: 2fr;
    height: 100%;
    layout: vertical;
}

#dash-left DataTable, #live-feed-log {
    overflow-x: hidden;
}

/* Modal overlays (Help `?` & Panel Zoom `z`) */
HelpScreen, ZoomScreen {
    align: center middle;
    background: rgba(6, 11, 17, 0.85);
}

#help-dialog {
    width: 74;
    height: auto;
    max-height: 28;
    background: #0b121c;
    border: round $gold;
    border-title-color: $gold-l;
    border-title-style: bold;
    padding: 1 2;
}

#zoom-dialog {
    width: 92%;
    height: 88%;
    background: #0b121c;
    border: round $gold;
    border-title-color: $gold-l;
    border-title-style: bold;
    padding: 0 1;
}

#zoom-scroll {
    height: 1fr;
}

/* Theme variants toggled with `t` */
Screen.theme-emerald .panel {
    border: round #065f46;
    border-title-color: #34d399;
}

Screen.theme-emerald .panel:focus-within,
Screen.theme-emerald Tab.-active {
    border: round #34d399;
    color: #34d399;
}

Screen.theme-violet .panel {
    border: round #4c1d95;
    border-title-color: #a78bfa;
}

Screen.theme-violet .panel:focus-within,
Screen.theme-violet Tab.-active {
    border: round #a78bfa;
    color: #a78bfa;
}

.split-h {
    height: 1fr;
    layout: horizontal;
}

.col-left-narrow {
    width: 45;
    height: 100%;
    margin-right: 1;
}

.col-left-mid {
    width: 2fr;
    height: 100%;
    margin-right: 1;
    layout: vertical;
}

.col-right-wide {
    width: 3fr;
    height: 100%;
    layout: vertical;
}

#plans-doc-scroll {
    height: 1fr;
    background: #060b11;
    border: round $line;
    border-title-color: $blue-l;
    border-title-style: bold;
    padding: 1 2;
}

#plans-summary-bar {
    height: 3;
    background: #060b11;
    border: round $gold;
    padding: 0 2;
    margin-bottom: 1;
    content-align: left middle;
}

#agents-sessions-box {
    height: 1fr;
    margin-bottom: 1;
}

#agents-tasks-box {
    height: 1fr;
}

#agents-activity-box {
    height: 1fr;
    margin-bottom: 1;
}

#agents-session-summary {
    height: auto;
    max-height: 6;
    padding: 0;
    border-bottom: solid $line;
    overflow: hidden hidden;
}

#agent-terminal-pane, #zoom-terminal-pane {
    height: 1fr;
    min-height: 12;
    background: #080f1a;
    color: #e2e8f0;
    padding: 0 1;
    overflow: hidden hidden;
}

#agent-terminal-pane:focus, #zoom-terminal-pane:focus {
    background: #0a1424;
}

#agents-log-box {
    height: 1fr;
    margin-bottom: 1;
}

#agent-composer-row {
    height: 3;
    layout: horizontal;
    align: left middle;
}

#agent-prompt-input {
    width: 1fr;
    min-width: 18;
    margin-right: 1;
    background: #060b11;
    border: round $gold;
}

#agent-prompt-input:focus {
    border: round $gold-l;
}

#agent-composer-row Button {
    min-width: 5;
    width: auto;
    height: 3;
    padding: 0;
    margin-right: 0;
    background: #060b11;
    border: round $line;
    color: #e2e8f0;
    text-style: bold;
}

#agent-composer-row #btn-agent-attach { border: round $gold; color: $gold-l; }
#agent-composer-row #btn-agent-graph { border: round #7c5cbf; color: #a78bfa; }
#agent-composer-row #btn-agent-view { border: round $blue; color: $blue-l; }
#agent-composer-row #btn-agent-new { border: round $blue; color: $blue-l; }
#agent-composer-row #btn-agent-voice { border: round $olive; color: $olive-l; }
#agent-composer-row #btn-agent-stop { border: round $terra; color: $terra-l; margin-right: 0; }

#git-files-box {
    height: 2fr;
    margin-bottom: 1;
}

#git-commits-box {
    height: 1fr;
}

#git-diff-box {
    height: 1fr;
}

#rag-search-row {
    height: 3;
    layout: horizontal;
    margin-bottom: 1;
}

#rag-input {
    width: 1fr;
    margin-right: 1;
    background: #060b11;
    border: round $line;
}

#rag-input:focus {
    border: round $gold;
}

#rag-mode-badge {
    width: auto;
    min-width: 18;
    height: 3;
    background: #060b11;
    border: round $blue;
    content-align: center middle;
    padding: 0 2;
    color: $blue-l;
    text-style: bold;
}

#knowledge-grid {
    height: 1fr;
    layout: horizontal;
}

#knowledge-left {
    width: 1fr;
    height: 100%;
    margin-right: 1;
    layout: vertical;
}

#knowledge-right {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

#rag-results-box {
    height: 3fr;
    margin-bottom: 1;
}

#gotchas-box {
    height: 2fr;
}

#doctor-box {
    height: 3fr;
    margin-bottom: 1;
}

#native-box {
    height: 2fr;
}

#tokens-grid {
    height: 1fr;
    layout: horizontal;
}

#tokens-left {
    width: 1fr;
    height: 100%;
    margin-right: 1;
    layout: vertical;
}

#tokens-right {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

#tokens-cat-box {
    height: 2fr;
    margin-bottom: 1;
}

#tokens-tools-box {
    height: 3fr;
}

#tokens-sessions-box {
    height: 2fr;
    margin-bottom: 1;
}

#tokens-harness-box {
    height: 3fr;
}

#runner-toolbar {
    height: 3;
    layout: horizontal;
    margin-bottom: 1;
    align: left middle;
}

#runner-toolbar Button {
    margin-right: 1;
    min-width: 15;
    height: 3;
    background: #060b11;
    border: round $line;
    color: #e2e8f0;
    text-style: bold;
}

#runner-toolbar Button:hover, #runner-toolbar Button:focus {
    background: #0f1826;
    text-style: bold reverse;
}

/* One logo bar color per action */
#runner-toolbar #btn-verify { border: round $olive; color: $olive-l; }
#runner-toolbar #btn-scan { border: round $terra; color: $terra-l; }
#runner-toolbar #btn-sync { border: round $blue; color: $blue-l; }
#runner-toolbar #btn-refresh-cmd { border: round $gold; color: $gold-l; }

#runner-status-bar {
    height: 3;
    background: #060b11;
    border: round $line;
    padding: 0 2;
    margin-bottom: 1;
    content-align: left middle;
}

#runner-output-box {
    height: 1fr;
}

DataTable {
    background: #111a2e;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #162036;
    color: $gold-l;
    text-style: bold;
}

DataTable > .datatable--even-row {
    background: #111a2e;
}

DataTable > .datatable--odd-row {
    background: #131e33;
}

DataTable > .datatable--cursor,
DataTable:focus > .datatable--cursor {
    background: #22324a;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #1a2638;
}

RichLog {
    background: #111a2e;
    height: 1fr;
}

Footer {
    background: #0f172a;
    color: #94a3b8;
}
